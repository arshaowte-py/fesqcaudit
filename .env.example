# Local development only. Nothing here is needed in production: on Cloud
# Functions the project id comes from the runtime, and the OTPless credentials
# come from Secret Manager.
#
# The Firebase project id is deliberately NOT in this file. It lives in
# .firebaserc and is resolved with `node scripts/firebase-project.mjs`.

# Photo bucket. In production this is derived from the runtime project id.
# STORAGE_BUCKET=

# OTPless (Secret Manager holds these in production; see README).
# OTPLESS_CLIENT_ID=
# OTPLESS_CLIENT_SECRET=

# Set to 1 to accept the console code 000000 instead of emailing a real one.
# Refuses to work when NODE_ENV=production or when running on Cloud Functions.
# ALLOW_DEV_OTP=

# Audit notification emails need no credentials here. The app writes to the
# `mail` collection in Firestore and the "Trigger Email from Firestore"
# extension delivers it; the provider API key lives in the extension's own
# config, not in this file.

# Optional overrides (comma-separated).
# QC_AUDIT_EMAIL_TO=
# QC_AUDIT_EMAIL_CC=
