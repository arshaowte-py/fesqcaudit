# Supabase (recommended for production deploys)
# Server-only — never expose the service role key in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Alternate name also supported locally / on Vercel:
# SUPABASE_SERVICE_SECRET_ROLE_KEY=

# If Supabase is not configured, the app falls back to local file storage
# at data/audits.json (great for local development).

# Microsoft Graph — audit notification emails (server-only)
# App registration needs Application permission Mail.Send + admin consent.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_SENDER_UPN=yourstruly@myfrido.com

# Optional overrides (comma-separated). Defaults: team in To, saiyed.a@myfrido.com in CC.
# QC_AUDIT_EMAIL_TO=yogesh.t@myfrido.com,mehak.g@myfrido.com,nishrit.p@myfrido.com,Siddhant.n@myfrido.com,Vaibhav.j@myfrido.com,Mayur.k@myfrido.com,arsh.a@myfrido.com
# QC_AUDIT_EMAIL_CC=saiyed.a@myfrido.com
