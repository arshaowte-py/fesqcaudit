rules_version = '2';

// Every read and write goes through the `server` Cloud Function using the
// Admin SDK, which bypasses these rules entirely. No client ever talks to
// Firestore directly, so the correct client-facing policy is: deny everything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
